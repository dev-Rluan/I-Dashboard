# 인증 (둘 다 설정 시 Basic Auth 활성화)
DASHBOARD_USER=
DASHBOARD_PASS=

# 자동 갱신 주기 (초)
REFRESH_INTERVAL=5

# Docker 내부에서 호스트 /proc, /sys 경로
HOST_PROC=/proc
HOST_SYS=/sys

# Docker Desktop(Windows/macOS) 환경 명시 (host mount 제약 안내용)
# DOCKER_HOST_OS=windows
# DOCKER_HOST_OS=macos

# ── 백엔드 ─────────────────────────────────────────────────────────
# 에이전트 인증 토큰 (설정 시 토큰 없는 에이전트 요청 거부)
AGENT_TOKEN=

# SQLite DB 경로
DB_PATH=data/dashboard.db

# ── 에이전트 (agent/main.py 또는 i-dashboard-agent.exe) ────────────
# 백엔드 서버 주소 (필수)
# BACKEND_URL=http://192.168.1.10:8000

# 인증 토큰 — 백엔드의 AGENT_TOKEN과 동일하게 설정
# AGENT_TOKEN=

# 대시보드에 표시될 식별자 (기본값: 호스트명)
# AGENT_NAME=

# 데이터 푸시 주기 (초, 기본값: 5)
# PUSH_INTERVAL=5
