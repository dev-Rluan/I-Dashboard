# 인증 (둘 다 설정 시 Basic Auth 활성화)
DASHBOARD_USER=
DASHBOARD_PASS=

# 자동 갱신 주기 (초)
REFRESH_INTERVAL=5

# Docker 내부에서 호스트 /proc, /sys 경로
HOST_PROC=/proc
HOST_SYS=/sys

# Docker Desktop(Windows/macOS) 환경 명시 (host mount 제약 안내용)
# DOCKER_HOST_OS=windows
# DOCKER_HOST_OS=macos

# 에이전트 인증 토큰 (backend/agent 양쪽에 동일하게 설정)
AGENT_TOKEN=

# SQLite DB 경로 (backend)
DB_PATH=data/dashboard.db

# ── 아래는 agent/main.py 실행 시 사용 ──────────────────────────────
# BACKEND_URL=http://192.168.1.10:8000
# AGENT_NAME=          # 기본값: 호스트명
# PUSH_INTERVAL=5
